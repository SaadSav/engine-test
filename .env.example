# Application Configuration
NODE_ENV=development
PORT=3000

# Logging Configuration
# Directory where log files will be stored (default: ./logs)
LOGS_DIR=./logs

# Set to 'true' to disable all logging (useful for testing)
LOG_SILENT=false

# Sentry Configuration (for error tracking and monitoring)
# Get your DSN from https://sentry.io/settings/[organization]/projects/[project]/keys/
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_ENABLED=true

# Sentry Performance Monitoring
# Sample rate for performance traces (0.0 to 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1
# Sample rate for profiling (0.0 to 1.0)
SENTRY_PROFILES_SAMPLE_RATE=0.1
# Enable debug mode for Sentry (logs additional information)
SENTRY_DEBUG=false
